rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /outlierGames/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    match /playerCivilizationMains/{profileId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if docId in ["publicStatus", "homepageHighlights", "archiveSnapshot", "civilizationMainsSnapshot", "mapPool"];
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
