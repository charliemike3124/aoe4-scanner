{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/scanOutliersNow",
        "function": {
          "functionId": "scanOutliersNow",
          "region": "us-central1"
        }
      },
      {
        "source": "/rescoreSavedOutliersNow",
        "function": {
          "functionId": "rescoreSavedOutliersNow",
          "region": "us-central1"
        }
      },
      {
        "source": "/refreshMapPoolNow",
        "function": {
          "functionId": "refreshMapPoolNow",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
