{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/civilizations/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/scanOutliersNow",
        "function": {
          "functionId": "scanOutliersNow",
          "region": "us-central1"
        }
      },
      {
        "source": "/rescoreSavedOutliersNow",
        "function": {
          "functionId": "rescoreSavedOutliersNow",
          "region": "us-central1"
        }
      },
      {
        "source": "/refreshMapPoolNow",
        "function": {
          "functionId": "refreshMapPoolNow",
          "region": "us-central1"
        }
      },
      {
        "source": "/refreshAgeupStatsNow",
        "function": {
          "functionId": "refreshAgeupStatsNow",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
